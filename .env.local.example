# Supabase project credentials
# Copy this file to .env.local and fill in the values from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry error monitoring
# DSN: Sentry dashboard → Project Settings → Client Keys (DSN)
# Must be NEXT_PUBLIC_ so it is available in client, server, and edge runtimes.
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXX.ingest.de.sentry.io/XXXXXXX

# Auth token for source map uploads at build time (Sentry → Settings → Auth Tokens)
# This is secret — never commit the real value. The wizard stores it in .env.sentry-build-plugin
# (gitignored). Add it to Vercel's environment variables under "Production" only.
SENTRY_AUTH_TOKEN=sntryu_your_auth_token

# Sentry org and project slugs (visible in your Sentry dashboard URL)
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Buttondown newsletter — subscriber creation
# Found in Buttondown → Settings → API keys.
# Server-only (no NEXT_PUBLIC_ prefix) — never ends up in the client bundle.
# Also add this to Vercel's environment variables for production.
BUTTONDOWN_API_KEY=your-buttondown-api-key
